# Yahoo Finance
YAHOO_QUOTE_API_URL=https://query2.finance.yahoo.com/v7/finance/quote
YAHOO_CHART_API_URL=https://query2.finance.yahoo.com/v8/finance/chart

# X-API headers (opcional)
YAHOO_X_API_HOST=finance.yahoo.com
YAHOO_X_API_KEY=coloque_sua_x_api_key_aqui

# Referer (opcional)
YAHOO_REFERER=https://finance.yahoo.com/
